<div class="postmark-home" data-studio-motion="{{ section.settings.enable_motion }}"><section class="p-hero"><div class="p-copy"><span class="s-eyebrow">ARCHIVE ENTRY / 001 / OCTOBER 2026</span><h1 data-reveal>{{ section.settings.heading | escape }}</h1><p class="s-lead">{{ section.settings.description | escape }}</p><a href="{{ routes.all_products_collection_url }}" class="s-cta primary">OPEN THE ARCHIVE ↗</a></div><div class="p-hero-art"><div class="p-paper one s-move" data-depth=".10"></div><div class="p-paper two s-move" data-depth=".24">P.</div><span class="p-stamp">AIR MAIL / 2026</span><span class="p-stamp circle">FROM OUR<br>ARCHIVE</span>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', class: 's-uploaded-hero', alt: section.settings.hero_image.alt }}{% endif %}</div></section><section class="p-catalog"><div class="shell"><strong>CURIOSITIES / VOL. 01</strong><span class="s-eyebrow">FILES, FINDS & EVERYDAY TREASURES</span></div></section><section class="s-section p-products"><div class="shell"><div class="s-products-head"><div><span class="s-eyebrow">ARCHIVE / 001–004</span><h2 class="s-section-title s-serif">Objects worth keeping.</h2></div><a href="{{ routes.all_products_collection_url }}" class="s-cta secondary">See all entries ↗</a></div>{% assign featured_collection = section.settings.collection %}{% if featured_collection == blank %}{% assign featured_collection = collections['all'] %}{% endif %}<div class="s-product-grid">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 4 %}{% render 'studio-card', product: product, index: forloop.index %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endfor %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endif %}</div></div></section><section class="p-ephemera"><div class="p-ephemera-art"><span class="s-move" data-depth=".18">✉</span></div><div class="p-ephemera-content" data-reveal><span class="s-eyebrow">A NOTE FROM OUR DESK</span><h2>Collected with curiosity.</h2><p class="s-lead">Little discoveries, big stories and finds that deserve a second look.</p></div></section></div>{% schema %}{"name":"POSTMARK homepage","settings":[{"type":"text","id":"heading","label":"Hero headline","default":"Good things have a story."},{"type":"textarea","id":"description","label":"Hero description","default":"Collected curiosities, beautiful objects and little things worth saving."},{"type":"image_picker","id":"hero_image","label":"Hero image (optional)"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"checkbox","id":"enable_motion","label":"Enable subtle parallax","default":true}],"presets":[{"name":"POSTMARK homepage"}]}{% endschema %}