<div class="p-cart postmark-cart shell s-cart"><span class="s-eyebrow">POSTMARK / YOUR SELECTION</span><h1>Your bag<span style="font-size:.4em;vertical-align:top"> ({{ cart.item_count }})</span></h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<div class="s-cart-item">{% if item.image != blank %}<a href="{{ item.url }}">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}</a>{% else %}<span>✳</span>{% endif %}<div><a class="s-cart-item-title" href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><a href="{{ item.url_to_remove }}" style="font-size:12px;text-decoration:underline">Remove</a></div><label>Qty <input type="number" name="updates[]" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}"></label><span>{{ item.final_line_price | money }}</span></div>{% endfor %}</div><div class="s-cart-summary"><div><span class="s-eyebrow">SUBTOTAL</span><p class="s-cart-total">{{ cart.total_price | money }}</p><p style="font-size:12px">Shipping and taxes calculated at checkout.</p></div><div class="s-cart-actions"><button class="s-cta secondary" type="submit" name="update">Update bag</button><button class="s-cta primary" type="submit" name="checkout">Checkout ↗</button></div></div></form>{% else %}<p class="s-lead">Your bag is waiting for something wonderful.</p><a href="{{ routes.all_products_collection_url }}" class="s-cta primary">Explore the collection ↗</a>{% endif %}</div>{% schema %}{"name":"POSTMARK cart","settings":[],"presets":[{"name":"POSTMARK cart"}]}{% endschema %}