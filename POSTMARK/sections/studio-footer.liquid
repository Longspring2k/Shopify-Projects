<footer class="p-footer"><div class="shell"><div class="p-footer-grid"><div><strong>POSTMARK.</strong><p>A collection of the unordinary.</p></div><div><span class="s-footer-title">DIRECTORY</span><a href="{{ routes.all_products_collection_url }}">THE ARCHIVE</a><a href="{{ routes.search_url }}">LOOK SOMETHING UP</a><a href="{{ routes.cart_url }}">YOUR PARCEL</a></div><div><span class="s-footer-title">THE POSTAL LIST</span><p>Letters from our little corner of the world.</p>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="s-newsletter"><input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" autocomplete="email" required><button type="submit" aria-label="Subscribe">↗</button></div>{% if form.posted_successfully? %}<p class="s-newsletter-feedback" role="status">Thank you for joining us.</p>{% endif %}{% if form.errors %}<div class="s-newsletter-feedback" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></div><div class="p-footer-bottom s-bottom">© {{ 'now' | date: '%Y' }} POSTMARK / FILED WITH CARE, FOREVER.</div></div></footer>{% schema %}{"name":"POSTMARK footer","settings":[],"presets":[{"name":"POSTMARK footer"}]}{% endschema %}