<div class="kinomi-home" data-studio-motion="{{ section.settings.enable_motion }}"><section class="k-hero"><div class="k-hero-copy"><span class="s-eyebrow">KINOMI / OBJECTS & RITUALS</span><h1 data-reveal>{{ section.settings.heading | escape }}</h1><p class="s-lead">{{ section.settings.description | escape }}</p><a href="{{ routes.all_products_collection_url }}" class="s-cta primary">Explore the collection ↗</a></div><div class="k-hero-art"><div class="k-halo s-move" data-depth=".12"></div><div class="k-vase s-move" data-depth=".22"></div><small class="k-note">OBJECT STUDY Nº 01</small>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', class: 's-uploaded-hero', alt: section.settings.hero_image.alt }}{% endif %}</div></section><section class="k-statement" data-reveal><span class="s-eyebrow">ひとつずつ / ONE THING AT A TIME</span><p>Space for what matters. Objects that feel at home.</p></section><section class="s-section k-products"><div class="shell"><div class="s-products-head"><div><span class="s-eyebrow">01 / THE EVERYDAY EDIT</span><h2 class="s-section-title s-serif">Thoughtfully selected.</h2></div><a href="{{ routes.all_products_collection_url }}" class="s-cta secondary">All objects ↗</a></div>{% assign featured_collection = section.settings.collection %}{% if featured_collection == blank %}{% assign featured_collection = collections['all'] %}{% endif %}<div class="s-product-grid">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 4 %}{% render 'studio-card', product: product, index: forloop.index %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endfor %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endif %}</div></div></section><section class="k-editorial"><div class="k-editorial-art"><span class="s-move" data-depth=".15"></span></div><div class="k-editorial-copy" data-reveal><span class="s-eyebrow">02 / THE KINOMI PHILOSOPHY</span><h2>A softer way of living.</h2><p class="s-lead">Not more things. Just the right ones, chosen with care.</p></div></section></div>{% schema %}{"name":"KINOMI homepage","settings":[{"type":"text","id":"heading","label":"Hero headline","default":"Room to breathe."},{"type":"textarea","id":"description","label":"Hero description","default":"Simple pieces. Honest materials. Space for the life around them."},{"type":"image_picker","id":"hero_image","label":"Hero image (optional)"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"checkbox","id":"enable_motion","label":"Enable subtle parallax","default":true}],"presets":[{"name":"KINOMI homepage"}]}{% endschema %}