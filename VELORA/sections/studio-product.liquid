<div class="v-product velora-product shell"><div class="s-product-page"><div class="s-product-media">{% if product.images.size > 0 %}{% for image in product.images limit: 3 %}<div class="s-product-photo">{{ image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '500, 850, 1200, 1500', sizes: '(min-width: 900px) 55vw, 100vw', alt: image.alt }}</div>{% endfor %}{% else %}<div class="s-product-photo"><span style="font-size:140px;opacity:.25">✳</span></div>{% endif %}</div><div class="s-product-info"><span class="s-eyebrow">AN OBJECT TO CHERISH</span><h1>{{ product.title | escape }}</h1><p class="s-price">{{ product.price | money }}</p>{% if product.compare_at_price > product.price %}<p><s>{{ product.compare_at_price | money }}</s></p>{% endif %}{% form 'product', product, id: 'studio-product-form' %}<label for="variant-velora">Select option</label><select id="variant-velora" name="id" required>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select><label for="qty-velora">Quantity</label><input type="number" id="qty-velora" name="quantity" value="1" min="1" required><button type="submit" class="s-cta primary" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag ↗{% else %}Sold out{% endif %}</button>{% endform %}<details open><summary>Details & story</summary><div class="s-description s-product-description">{% if product.description != blank %}{{ product.description }}{% else %}A thoughtfully selected object from the connected store.{% endif %}</div></details><p class="s-meta-note">TIMELESS. TACTILE. PERSONAL.</p><a class="s-back" href="{{ routes.all_products_collection_url }}">← Back to the collection</a></div></div></div>{% schema %}{"name":"VELORA product","settings":[],"presets":[{"name":"VELORA product"}]}{% endschema %}