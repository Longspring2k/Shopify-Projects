<footer class="v-footer"><div class="shell"><div class="v-footer-grid"><div><h2>VELORA</h2><p>Artfully considered, beautifully lived.</p></div><div><span class="s-footer-title">THE COLLECTION</span><a href="{{ routes.all_products_collection_url }}">View all pieces</a><a href="{{ routes.search_url }}">Find an object</a><a href="{{ routes.cart_url }}">Your basket</a></div><div><span class="s-footer-title">LETTERS FROM US</span><p>Occasional notes on objects and living.</p>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="s-newsletter"><input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" autocomplete="email" required><button type="submit" aria-label="Subscribe">↗</button></div>{% if form.posted_successfully? %}<p class="s-newsletter-feedback" role="status">Thank you for joining us.</p>{% endif %}{% if form.errors %}<div class="s-newsletter-feedback" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></div><div class="v-footer-bottom s-bottom"><span>© {{ 'now' | date: '%Y' }} VELORA</span><span>CONSIDERED THINGS, BEAUTIFULLY MADE.</span></div></div></footer>{% schema %}{"name":"VELORA footer","settings":[],"presets":[{"name":"VELORA footer"}]}{% endschema %}