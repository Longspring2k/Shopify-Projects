<div class="velora-home" data-studio-motion="{{ section.settings.enable_motion }}"><section class="v-hero"><div class="v-hero-copy" data-reveal><span class="s-eyebrow">COLLECTION NO. 01 · AN EXERCISE IN ELEGANCE</span><h1>{{ section.settings.heading | escape }}</h1><p class="s-lead">{{ section.settings.description | escape }}</p><a href="{{ routes.all_products_collection_url }}" class="s-cta primary">Discover the collection &nbsp; ↗</a></div><div class="v-hero-art"><div class="v-arch s-move" data-depth=".18"></div><span class="v-hero-note">A STUDY IN TIMELESS FORM · 001</span>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', class: 's-uploaded-hero', alt: section.settings.hero_image.alt }}{% endif %}</div></section><section class="v-quote" data-reveal><span class="s-eyebrow">AN OBJECT. A MOMENT. A FEELING.</span><p>“Beauty lives in the details we choose to keep.”</p></section><section class="s-section v-products"><div class="shell"><div class="s-products-head" data-reveal><div><span class="s-eyebrow">01 / THE CURATED EDIT</span><h2 class="s-section-title s-serif">A quieter kind of luxury.</h2></div><a href="{{ routes.all_products_collection_url }}" class="s-cta secondary">View all ↗</a></div>{% assign featured_collection = section.settings.collection %}{% if featured_collection == blank %}{% assign featured_collection = collections['all'] %}{% endif %}<div class="s-product-grid">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 4 %}{% render 'studio-card', product: product, index: forloop.index %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endfor %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endif %}</div></div></section><section class="s-section shell v-editorial"><div class="v-editorial-art s-move" data-depth=".12"></div><div data-reveal><span class="s-eyebrow">THE ART OF THE EVERYDAY</span><h2 class="s-section-title s-serif">Made to be lived with.</h2><p class="s-lead">Honest forms, warm textures and the kind of beauty that never asks for attention.</p><a href="{{ routes.all_products_collection_url }}" class="s-cta secondary">Explore the objects ↗</a></div></section></div>{% schema %}{"name":"VELORA homepage","settings":[{"type":"text","id":"heading","label":"Hero headline","default":"The art of living beautifully."},{"type":"textarea","id":"description","label":"Hero description","default":"A considered edit of objects, selected for the moments that matter."},{"type":"image_picker","id":"hero_image","label":"Hero image (optional)"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"checkbox","id":"enable_motion","label":"Enable subtle parallax","default":true}],"presets":[{"name":"VELORA homepage"}]}{% endschema %}