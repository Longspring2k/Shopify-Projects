{% doc %}Renders a MORUVA product card. @param {product} product - Product to display. {% enddoc %}<a class="m-product" href="{{ product.url }}"><div class="m-product-img">{% if product.featured_image %}{{ product.featured_image | image_url: width: 750 | image_tag: loading: 'lazy', widths: '260, 420, 750', sizes: '(min-width: 900px) 25vw, 50vw', alt: product.title }}{% else %}<span class="m-placeholder" aria-hidden="true">✳</span>{% endif %}</div><div class="m-product-info"><span class="m-product-title">{{ product.title | escape }}</span><span class="m-product-price">{{ product.price | money }}</span></div></a>