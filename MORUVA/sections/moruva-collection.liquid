<div class="moruva-shell"><div class="m-container"><div class="m-collection-head"><span class="m-eyebrow">THE MORUVA EDIT ✳</span><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="m-bodycopy" style="margin:auto">{{ collection.description }}</div>{% else %}<p class="m-bodycopy" style="margin:auto">Curious things for brighter everyday living.</p>{% endif %}</div>{% paginate collection.products by 24 %}<div class="m-products m-collection-grid">{% for product in collection.products %}{% render 'moruva-card', product: product %}{% else %}<p class="m-empty">Objects coming soon.</p>{% endfor %}</div><div style="text-align:center;padding:10px 0 80px;font-size:16px">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></div>{% schema %}{"name":"Moruva collection","settings":[],"presets":[{"name":"Moruva collection"}]}{% endschema %}