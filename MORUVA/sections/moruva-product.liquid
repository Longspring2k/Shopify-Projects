<div class="moruva-shell"><div class="m-container"><div class="m-product-page"><div class="m-product-gallery">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '550, 800, 1100, 1400', sizes: '(min-width: 900px) 55vw, 100vw', alt: product.title }}{% else %}<div class="m-placeholder">✳</div>{% endif %}</div><div class="m-product-content"><span class="m-eyebrow">MORUVA / THE OBJECT EDIT</span><h1>{{ product.title | escape }}</h1><p class="price">{{ product.price | money }}</p>{% if product.description != blank %}<div class="m-bodycopy">{{ product.description }}</div>{% endif %}{% form 'product', product, id: 'm-product-form' %}<label class="m-eyebrow" for="m-variant-{{ section.id }}">Choose your option</label><select id="m-variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label class="m-eyebrow" for="m-qty-{{ section.id }}">Quantity</label><input id="m-qty-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button class="m-button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}ADD TO BAG ↗{% else %}SOLD OUT{% endif %}</button>{% endform %}<p style="font-size:13px;margin-top:24px">✳ Thoughtful design for everyday moments.</p><a class="m-text-link" href="{{ routes.all_products_collection_url }}">← Back to all objects</a></div></div></div></div>{% schema %}{"name":"Moruva product","settings":[],"presets":[{"name":"Moruva product"}]}{% endschema %}