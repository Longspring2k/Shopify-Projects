<section class="sv-page-banner {% if section.settings.color_mode == 'lavender' %}sv-page-banner--lavender{% endif %}"><div class="sv-wrap"><p class="sv-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}<br><em>{{ section.settings.italic | escape }}</em></h1><p class="sv-page-banner__desc">{{ section.settings.description | escape }}</p><span class="sv-page-banner__stamp">N + / 02</span></div></section>
{% schema %}{"name":"STRATA page banner","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NORTHLINE / ON THE RECORD"},{"type":"text","id":"heading","label":"Heading","default":"BEYOND THE"},{"type":"text","id":"italic","label":"Italic heading","default":"expected."},{"type":"textarea","id":"description","label":"Description","default":"Every good story starts somewhere. Ours starts outside."},{"type":"select","id":"color_mode","label":"Theme","options":[{"value":"dark","label":"Midnight"},{"value":"lavender","label":"Lavender"}],"default":"dark"}],"presets":[{"name":"STRATA page banner"}]}{% endschema %}