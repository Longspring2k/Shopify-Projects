<section class="sv-section sv-cart"><div class="sv-wrap"><p class="sv-eyebrow">NORTHLINE / FIELD BAG</p><h1 class="sv-interior-title">YOUR <em>bag.</em></h1>
{% if cart.item_count == 0 %}<div class="sv-cart__empty"><h2>Your bag is waiting for adventure.</h2><a class="sv-pill sv-pill--dark" href="{{ routes.all_products_collection_url }}">CONTINUE SHOPPING <span>&nearr;</span></a></div>
{% else %}
<form action="{{ routes.cart_url }}" method="post" class="sv-cart__form"><div class="sv-cart__items">
{% for item in cart.items %}<article class="sv-cart__item"><a href="{{ item.url }}" class="sv-cart__photo">{% if item.image %}{{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', alt: item.product.title }}{% else %}<span>N / 02</span>{% endif %}</a><div class="sv-cart__item-details"><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p><label for="sv-cart-qty-{{ forloop.index }}">Quantity</label><input id="sv-cart-qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="sv-textlink" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0">Remove</a></div></article>{% endfor %}
</div><aside class="sv-cart__summary"><p class="sv-eyebrow">YOUR ORDER / 02</p><div><span>SUBTOTAL</span><strong>{{ cart.total_price | money }}</strong></div><p>Taxes and shipping calculated at checkout.</p><button class="sv-pill sv-pill--outline-dark" type="submit" name="update">UPDATE BAG <span>&nearr;</span></button><button class="sv-pill sv-pill--dark" type="submit" name="checkout">GO TO CHECKOUT <span>&nearr;</span></button></aside></form>
{% endif %}</div></section>
{% schema %}{"name":"STRATA cart","settings":[]}{% endschema %}