{% assign chosen_variant = product.selected_or_first_available_variant %}
<section class="sv-product"><div class="sv-wrap"><nav class="sv-crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Shop</a><span>/</span><span>{{ product.title | escape }}</span></nav>
<div class="sv-product__grid"><div class="sv-product__gallery">
{% if product.images.size > 0 %}{% for image in product.images limit: 6 %}{% assign image_alt = image.alt | default: product.title %}<figure class="sv-product__image {% if forloop.first %}sv-product__image--main{% endif %}">{{ image | image_url: width: 1250 | image_tag: loading: 'lazy', alt: image_alt }}</figure>{% endfor %}{% else %}<figure class="sv-product__image sv-product__image--main"><img src="{{ 'strata-board.svg' | asset_url }}" alt="Snowboard illustration" width="400" height="700"></figure>{% endif %}
</div><div class="sv-product__detail"><div class="sv-product__sticky"><p class="sv-eyebrow">NORTHLINE / EQUIPMENT SYSTEM</p><h1>{{ product.title | escape }}</h1><p class="sv-micro">THE GOOD STUFF, BUILT FOR GETTING OUT THERE.</p><p class="sv-product__price" data-strata-price>{{ chosen_variant.price | money }}</p>
{% form 'product', product, class: 'sv-product__form' %}
{% if product.variants.size > 1 %}<label for="sv-variant-{{ section.id }}">Choose your option</label><select id="sv-variant-{{ section.id }}" name="id" data-strata-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" {% if variant.id == chosen_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ chosen_variant.id }}">{% endif %}
<label for="sv-qty-{{ section.id }}">Quantity</label><input id="sv-qty-{{ section.id }}" type="number" min="1" name="quantity" value="1" inputmode="numeric">
<button class="sv-pill sv-pill--dark sv-product__add" type="submit" data-strata-submit {% unless product.available %}disabled{% endunless %}>{% if product.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}<span>&nearr;</span></button>
{% endform %}
<div class="sv-product__accordions"><details open><summary>PRODUCT DETAILS <span>+</span></summary><div class="sv-product__description">{{ product.description }}</div></details><details><summary>DELIVERY &amp; RETURNS <span>+</span></summary><div class="sv-product__description">Shipping calculated at checkout. See our policies for returns.</div></details></div><div class="sv-product__footnote"><span>✳ RIDE OUTSIDE THE ORDINARY.</span><span>NORTHLINE / 02</span></div>
</div></div></div></div></section>
{% schema %}{"name":"STRATA product details","settings":[]}{% endschema %}