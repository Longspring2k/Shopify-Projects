<div class="sv-topbar"><span>&#9679; {{ section.settings.notice | escape }}</span><span class="sv-topbar__right">NORTHLINE / FIELD SUPPLY CO. &mdash; 001</span></div>
<header class="sv-header"><div class="sv-wrap sv-header__inner">
<a class="sv-brand" href="{{ routes.root_url }}" aria-label="Northline Home"><span class="sv-brand__mark">N<span>+</span></span><span class="sv-brand__name">{{ settings.strata_brand | default: 'NORTHLINE' | escape }}<small>FIELD SUPPLY CO.</small></span></a>
<nav class="sv-desktop-nav" aria-label="Main navigation"><a href="{{ routes.root_url }}">{{ 'strata.navigation.home' | t }}</a><a href="{{ routes.all_products_collection_url }}">{{ 'strata.navigation.shop' | t }}</a><a href="/collections/hydrogen">{{ 'strata.navigation.collection' | t }}</a><a href="/pages/about">{{ 'strata.navigation.story' | t }}</a><a href="/pages/contact">{{ 'strata.navigation.contact' | t }}</a></nav>
<div class="sv-header__actions"><a class="sv-header__search" href="{{ routes.search_url }}" aria-label="Search"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></a><a class="sv-header__bag" href="{{ routes.cart_url }}">Bag <span aria-label="{{ cart.item_count }} items">{{ cart.item_count }}</span></a><details class="sv-menu"><summary aria-label="Open menu"><span></span><span></span></summary><nav class="sv-menu__panel"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="/collections/hydrogen">Collection</a><a href="/pages/about">Our story</a><a href="/pages/contact">Contact</a></nav></details></div>
</div></header>
