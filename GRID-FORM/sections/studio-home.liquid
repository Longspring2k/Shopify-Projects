<div class="gridform-home" data-studio-motion="{{ section.settings.enable_motion }}"><section class="g-hero"><div class="g-rail">GRID/FORM · COLLECTION 001 · 2026</div><div class="g-hero-copy"><span class="s-eyebrow">GF—001 / THE EVERYDAY OBJECT INDEX</span><h1 data-reveal>{{ section.settings.heading | escape }}</h1><div><p class="s-lead">{{ section.settings.description | escape }}</p><a class="s-cta primary" href="{{ routes.all_products_collection_url }}">ENTER THE INDEX ↗</a></div></div><div class="g-hero-right"><div class="g-red-square s-move" data-depth=".23">GF.</div><span class="g-right-label">FORM FOLLOWS FUNCTION / GF-001</span>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', class: 's-uploaded-hero', alt: section.settings.hero_image.alt }}{% endif %}</div></section><div class="g-marquee">+ DESIGN IS FUNCTION + GOOD FORM IS GOOD THINKING + OBJECT / SYSTEM / EVERYDAY +</div><section class="g-intro"><div data-reveal><span class="s-eyebrow">[01] / MANIFESTO</span><h2>LESS BUT<br>BETTER.</h2></div><div data-reveal><span class="s-eyebrow">[02] / USE CASE</span><p class="s-lead">Objects for people who value purpose as much as presence.</p><a href="{{ routes.all_products_collection_url }}" class="s-cta secondary">VIEW THE CATALOGUE ↗</a></div></section><section class="g-products"><div class="shell"><div class="s-products-head"><h2 class="s-section-title">SELECTED / 001–004</h2><span class="s-eyebrow">INVENTORY INDEX</span></div>{% assign featured_collection = section.settings.collection %}{% if featured_collection == blank %}{% assign featured_collection = collections['all'] %}{% endif %}<div class="s-product-grid">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 4 %}{% render 'studio-card', product: product, index: forloop.index %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endfor %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endif %}</div></div></section><section class="g-typography"><strong class="s-move" data-depth=".13">FORM.</strong><span>FUNCTION / IS / BEAUTIFUL.</span></section></div>{% schema %}{"name":"GRID/FORM homepage","settings":[{"type":"text","id":"heading","label":"Hero headline","default":"DESIGNED / FOR REAL LIFE."},{"type":"textarea","id":"description","label":"Hero description","default":"No noise. No excess. Just smart objects, clearly considered."},{"type":"image_picker","id":"hero_image","label":"Hero image (optional)"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"checkbox","id":"enable_motion","label":"Enable subtle parallax","default":true}],"presets":[{"name":"GRID/FORM homepage"}]}{% endschema %}