<section class="shell s-general"><span class="s-eyebrow">NEXØ / OUR STORY</span><h1>{{ page.title | escape }}</h1><div class="s-rte">{{ page.content }}</div><a href="{{ routes.all_products_collection_url }}" class="s-back">← Explore the collection</a></section>{% stylesheet %}.s-general{padding-block:clamp(70px,9vw,145px);max-width:1150px}.s-general h1{font-size:clamp(56px,8vw,135px);letter-spacing:-.065em;line-height:1;margin:18px 0 35px;font-family:inherit}.s-general .s-rte{font-size:17px;line-height:1.85;max-width:850px}.s-general .s-rte img{height:auto}.s-general-search{display:flex;gap:10px;margin:35px 0 50px;max-width:780px}.s-general-search input{min-width:0;flex:1;padding:15px;background:transparent;color:inherit;border:1px solid var(--line)}.s-general-results{padding:10px 0 50px}.s-general-404{text-align:center;min-height:62vh;display:flex;flex-direction:column;align-items:center;justify-content:center}.s-general-404 h1{font-size:clamp(85px,15vw,230px);margin:6px 0 25px}.s-general-404 p{max-width:480px;font-size:18px;line-height:1.6}.s-general .s-cta{max-width:max-content}@media(max-width:650px){.s-general-search{flex-direction:column}.s-general-404{min-height:55vh}}{% endstylesheet %}{% schema %}{"name":"NEXØ page","settings":[],"presets":[{"name":"NEXØ page"}]}{% endschema %}