<div class="n-collection nexo-collection shell"><header class="s-collection-head"><span class="s-eyebrow">HARDWARE DATABASE // LIVE</span><h1 class="s-collection-title">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="s-description">{{ collection.description }}</div>{% else %}<p class="s-lead">Hardware for what comes next.</p>{% endif %}</header>{% paginate collection.products by 16 %}<div class="s-sort"><span>{{ collection.products_count }} objects</span><form action="{{ collection.url }}" method="get"><label for="sort-nexo">Sort</label><select id="sort-nexo" name="sort_by" onchange="this.form.submit()">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></form></div><div class="s-collection-body s-product-grid">{% for product in collection.products %}{% render 'studio-card', product: product, index: forloop.index %}{% else %}<p class="s-empty">The collection is being prepared.</p>{% endfor %}</div><div class="s-pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>{% schema %}{"name":"NEXØ collection","settings":[],"presets":[{"name":"NEXØ collection"}]}{% endschema %}