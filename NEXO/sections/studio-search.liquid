<section class="shell s-general"><span class="s-eyebrow">NEXØ / FIND SOMETHING</span><h1>Search the edit.</h1><form class="s-general-search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?" aria-label="Search products" required><input type="hidden" name="type" value="product"><button class="s-cta primary" type="submit">Find objects ↗</button></form>{% if search.performed %}<div class="s-general-results"><p class="s-eyebrow">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 16 %}<div class="s-product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'studio-card', product: item, index: forloop.index %}{% endif %}{% else %}<p class="s-empty">No objects found. Try another search.</p>{% endfor %}</div><div class="s-pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>{% endif %}</section>{% stylesheet %}.s-general{padding-block:clamp(70px,9vw,145px);max-width:1150px}.s-general h1{font-size:clamp(56px,8vw,135px);letter-spacing:-.065em;line-height:1;margin:18px 0 35px;font-family:inherit}.s-general .s-rte{font-size:17px;line-height:1.85;max-width:850px}.s-general .s-rte img{height:auto}.s-general-search{display:flex;gap:10px;margin:35px 0 50px;max-width:780px}.s-general-search input{min-width:0;flex:1;padding:15px;background:transparent;color:inherit;border:1px solid var(--line)}.s-general-results{padding:10px 0 50px}.s-general-404{text-align:center;min-height:62vh;display:flex;flex-direction:column;align-items:center;justify-content:center}.s-general-404 h1{font-size:clamp(85px,15vw,230px);margin:6px 0 25px}.s-general-404 p{max-width:480px;font-size:18px;line-height:1.6}.s-general .s-cta{max-width:max-content}@media(max-width:650px){.s-general-search{flex-direction:column}.s-general-404{min-height:55vh}}{% endstylesheet %}{% schema %}{"name":"NEXØ search","settings":[],"presets":[{"name":"NEXØ search"}]}{% endschema %}