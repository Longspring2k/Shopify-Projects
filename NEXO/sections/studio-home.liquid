<div class="nexo-home" data-studio-motion="{{ section.settings.enable_motion }}"><section class="n-hero"><div class="shell"><div class="n-hero-copy"><span class="s-eyebrow">NEXØ / SYSTEM ONLINE / COLLECTION 001</span><h1 data-reveal>{{ section.settings.heading | escape }}</h1><p class="s-lead">{{ section.settings.description | escape }}</p><a class="s-cta primary" href="{{ routes.all_products_collection_url }}">INITIALIZE DISCOVERY ↗</a></div><div class="n-orbit"><div class="n-orbit s-move" data-depth=".28"><div class="n-orb-core"></div></div><div class="n-hud">OBJECT_ID // NX-001<br>SYSTEM STATUS: ACTIVE</div>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', class: 's-uploaded-hero', alt: section.settings.hero_image.alt }}{% endif %}</div></div></section><div class="n-metrics"><div><strong>01</strong>SYSTEM / SELECT</div><div><strong>02</strong>PROCESS / EXPLORE</div><div><strong>03</strong>OUTPUT / LIVE</div></div><section class="s-section n-products"><div class="shell"><div class="s-products-head"><div><span class="s-eyebrow">DATABASE // OPEN</span><h2 class="s-section-title">LATEST HARDWARE_</h2></div><a href="{{ routes.all_products_collection_url }}" class="s-cta secondary">VIEW ALL ITEMS ↗</a></div>{% assign featured_collection = section.settings.collection %}{% if featured_collection == blank %}{% assign featured_collection = collections['all'] %}{% endif %}<div class="s-product-grid">{% if featured_collection != blank %}{% for product in featured_collection.products limit: 4 %}{% render 'studio-card', product: product, index: forloop.index %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endfor %}{% else %}<p class="s-empty">New objects coming soon.</p>{% endif %}</div></div></section><section class="n-manifesto"><div><span class="s-eyebrow">MANIFESTO 001</span><h2>FORWARD<br>ONLY.</h2></div><p class="s-lead">Tomorrow doesn't arrive. We design it, piece by piece.</p></section></div>{% schema %}{"name":"NEXØ homepage","settings":[{"type":"text","id":"heading","label":"Hero headline","default":"ENTER THE NEXT STATE."},{"type":"textarea","id":"description","label":"Hero description","default":"Designed at the intersection of bold engineering and future culture."},{"type":"image_picker","id":"hero_image","label":"Hero image (optional)"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"checkbox","id":"enable_motion","label":"Enable subtle parallax","default":true}],"presets":[{"name":"NEXØ homepage"}]}{% endschema %}